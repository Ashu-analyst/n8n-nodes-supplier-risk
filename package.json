{
  "name": "n8n-nodes-supplier-risk",
  "version": "0.1.0",
  "description": "n8n community node: scores supplier risk (country, category, questionnaire, adverse media) and returns a risk band and approval route.",
  "keywords": [
    "n8n-community-node-package",
    "supplier-risk",
    "esg",
    "due-diligence"
  ],
  "license": "MIT",
  "author": "Aeshwarya Das",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/SupplierRisk/SupplierRisk.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "n8n-workflow": "^1.120.35",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
